{
    "data_release": "DR3",

    "source": {
        "name": "ESA Gaia Archive",
        "table": "gaiadr3.gaia_source"
    },

    "input": {
        "directory": "raw"
    },

    "output": {
        "directory": "processed",
        "format": "binary"
    },

    "fields": [
        "source_id",
        "ra",
        "dec",
        "parallax",
        "phot_g_mean_mag",
        "bp_rp"
    ],

    "processing": {
        "coordinate_system": "cartesian",
        "distance_unit": "parsec",
        "remove_invalid_parallax": true
    },

    "rendering": {
        "use_gpu_buffer": true,
        "lod": false,
        "max_stars": 1000000
    }
}