#pragma kernel ClearCacheKernel
#pragma kernel RasterizeCacheKernel

#pragma target 4.5


// ============================================================
// Star data
// ============================================================

struct StarData
{
    float3 position;
    float magnitude;
    float bpRp;
};

StructuredBuffer<StarData> _Stars;


// ============================================================
// Cache accumulation buffers
// ============================================================

RWStructuredBuffer<uint> _CacheLuminance;
RWStructuredBuffer<uint> _CacheColorLuminance;


// ============================================================
// Cache parameters
// ============================================================

uint _CacheWidth;
uint _CacheHeight;

uint _StarCount;

float3 _CachePosition;

float _FarCacheDistance;

float _BrightnessMultiplier;

float _StorageScale;

float _ColorMin;
float _ColorMax;

int _FixedScale;


// ============================================================
// Pixel indexing
// ============================================================

uint CachePixelIndex(
    uint2 pixel
)
{
    return
        pixel.y * _CacheWidth +
        pixel.x;
}


// ============================================================
// Add one contribution
//
// X wraps because longitude is cyclic.
// Y does not wrap because latitude ends at the poles.
// ============================================================

void AddContribution(
    int2 pixel,
    float luminance,
    float bpRpNormalized
)
{
    if (pixel.y < 0 ||
        pixel.y >= (int)_CacheHeight)
    {
        return;
    }

    if (luminance <= 0.0)
    {
        return;
    }

    // --------------------------------------------------------
    // Horizontal wrapping without integer modulus.
    //
    // For this rasterizer pixel.x can only be:
    //
    //     0 ... width-1
    //     -1
    //     width
    //
    // because each star touches only a 2x2 neighbourhood.
    // --------------------------------------------------------

    uint wrappedX;

    if (pixel.x < 0)
    {
        wrappedX =
            (uint)(pixel.x + (int)_CacheWidth);
    }
    else if (pixel.x >= (int)_CacheWidth)
    {
        wrappedX =
            (uint)(pixel.x - (int)_CacheWidth);
    }
    else
    {
        wrappedX =
            (uint)pixel.x;
    }

    uint index =
        CachePixelIndex(
            uint2(
                wrappedX,
                (uint)pixel.y
            )
        );


    // --------------------------------------------------------
    // Fixed-point conversion.
    // --------------------------------------------------------

    float scaledLuminance =
        luminance *
        (float)_FixedScale;

    float scaledColor =
        luminance *
        bpRpNormalized *
        (float)_FixedScale;


    uint luminanceInteger =
        (uint)max(
            scaledLuminance + 0.5,
            0.0
        );

    uint colorInteger =
        (uint)max(
            scaledColor + 0.5,
            0.0
        );


    // --------------------------------------------------------
    // Atomic accumulation.
    // --------------------------------------------------------

    if (luminanceInteger > 0)
    {
        InterlockedAdd(
            _CacheLuminance[index],
            luminanceInteger
        );
    }

    if (colorInteger > 0)
    {
        InterlockedAdd(
            _CacheColorLuminance[index],
            colorInteger
        );
    }
}


// ============================================================
// Clear cache
// ============================================================

[numthreads(8, 8, 1)]
void ClearCacheKernel(
    uint3 id : SV_DispatchThreadID
)
{
    if (id.x >= _CacheWidth ||
        id.y >= _CacheHeight)
    {
        return;
    }

    uint index =
        id.y * _CacheWidth +
        id.x;

    _CacheLuminance[index] = 0;
    _CacheColorLuminance[index] = 0;
}


// ============================================================
// Rasterize one far-cache node
// ============================================================

[numthreads(64, 1, 1)]
void RasterizeCacheKernel(
    uint3 id : SV_DispatchThreadID
)
{
    uint starIndex =
        id.x;

    if (starIndex >= _StarCount)
    {
        return;
    }

    StarData star =
        _Stars[starIndex];


    // ========================================================
    // Exact far-distance test
    // ========================================================

    float3 relative =
        star.position -
        _CachePosition;

    float distanceSquared =
        dot(
            relative,
            relative
        );

    float farDistanceSquared =
        _FarCacheDistance *
        _FarCacheDistance;

    if (distanceSquared <=
        farDistanceSquared)
    {
        return;
    }


    float distance =
        sqrt(
            distanceSquared
        );

    if (distance <= 0.000001)
    {
        return;
    }


    float3 direction =
        relative /
        distance;


    // ========================================================
    // Apparent brightness
    //
    // Same magnitude model as the main Gaia rasterizer.
    // ========================================================

    float luminance =
        pow(
            10.0,
            -0.4 * star.magnitude
        )
        *
        _BrightnessMultiplier;


    if (luminance <= 0.0)
    {
        return;
    }


    // ========================================================
    // BP-RP normalization
    // ========================================================

    float bpRpNormalized =
        saturate(
            (star.bpRp - _ColorMin)
            /
            (_ColorMax - _ColorMin)
        );


    // ========================================================
    // World direction -> equirectangular coordinates
    //
    // longitude:
    //     [-pi, +pi]
    //
    // latitude:
    //     [-pi/2, +pi/2]
    //
    // resulting:
    //     u in [0, 1)
    //     v in [0, 1]
    // ========================================================

    float longitude =
        atan2(
            direction.x,
            direction.z
        );

    float latitude =
        asin(
            clamp(
                direction.y,
                -1.0,
                1.0
            )
        );


    float u =
        longitude /
        (2.0 * 3.14159265359)
        + 0.5;

    float v =
        latitude /
        3.14159265359
        + 0.5;


    // ========================================================
    // Continuous cache position
    //
    // Subtract 0.5 so integer positions correspond to pixel
    // centers, matching the main Gaia rasterizer.
    // ========================================================

    float2 continuousPosition =
        float2(
            u * _CacheWidth,
            v * _CacheHeight
        )
        - 0.5;


    int2 basePixel =
        int2(
            floor(
                continuousPosition
            )
        );


    float2 fraction =
        frac(
            continuousPosition
        );


    float wx =
        fraction.x;

    float wy =
        fraction.y;


    // ========================================================
    // Bilinear 2x2 weights
    // ========================================================

    float w00 =
        (1.0 - wx) *
        (1.0 - wy);

    float w10 =
        wx *
        (1.0 - wy);

    float w01 =
        (1.0 - wx) *
        wy;

    float w11 =
        wx *
        wy;


    int2 p00 =
        basePixel;

    int2 p10 =
        basePixel +
        int2(1, 0);

    int2 p01 =
        basePixel +
        int2(0, 1);

    int2 p11 =
        basePixel +
        int2(1, 1);


    // ========================================================
    // Accumulate
    //
    // X wraps automatically inside AddContribution().
    // Y is clipped there.
    // ========================================================

    AddContribution(
        p00,
        luminance * w00,
        bpRpNormalized
    );

    AddContribution(
        p10,
        luminance * w10,
        bpRpNormalized
    );

    AddContribution(
        p01,
        luminance * w01,
        bpRpNormalized
    );

    AddContribution(
        p11,
        luminance * w11,
        bpRpNormalized
    );
}